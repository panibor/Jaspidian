{
  "manifest_version": 3,
  "name": "Jaspidian",
  "description": "Save Facebook posts you can see in your browser into your Obsidian vault as Markdown notes.",
  "version": "1.0.0",
  "icons": {
    "16": "assets/logo_16.png",
    "32": "assets/logo_32.png",
    "48": "assets/logo_48.png",
    "128": "assets/logo_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jaspidian",
    "default_icon": {
      "16": "assets/logo_16.png",
      "32": "assets/logo_32.png",
      "48": "assets/logo_48.png",
      "128": "assets/logo_128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "tabs", "downloads", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*", "https://facebook.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://facebook.com/*",
    "https://*.fbcdn.net/*",
    "http://127.0.0.1:37123/*"
  ]
}
