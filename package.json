{
  "name": "jaspidian-extension",
  "version": "1.1.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/panibor/jaspidian.git"
  },
  "homepage": "https://github.com/panibor/jaspidian",
  "bugs": "https://github.com/panibor/jaspidian/issues",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build && node ./node_modules/vite/bin/vite.js build --config vite.content.config.ts",
    "build:firefox": "npm run build && node scripts/build-firefox.mjs",
    "release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.315",
    "typescript": "^5.7.2",
    "vite": "^6.4.2"
  }
}
